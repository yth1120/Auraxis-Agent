# Auraxis 环境变量模板（复制为 .env 后填写；.env 已被 .gitignore 忽略）

# DeepSeek（OpenAI 兼容格式，默认）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/beta/chat/completions

# 内置模型：deepseek-v4-flash、deepseek-v4-pro、deepseek-v4-flash-vision-exp（实验性图片理解）
# DeepSeek Anthropic 格式端点（可选，设置后 deepseek-* 模型走 Anthropic 协议）
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic/v1/messages

# Anthropic / OpenAI 兼容端点（可选）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# LLM 网关（可选）
# 默认：OpenAI 兼容线（/chat/completions）走官方 Vercel AI SDK；Anthropic Messages 与
# Responses 仍走内置适配器（尚未接入 SDK 路径）。设为 builtin 可整体回退到内置实现，
# 作为应急开关，无需改代码重新发版。
# AURAXIS_LLM_GATEWAY=builtin

# 自定义模型（JSON 数组）。除 id/name 外均为可选：
#   provider     第三方或自建端点可显式声明（deepseek | openai | anthropic | 任意字符串），
#                未声明时按历史默认归为 deepseek
#   protocol     openai-chat | anthropic-messages | openai-responses；非法值会被丢弃并回退到
#                由 apiBase 形状推断（见 resolveModelProtocol）
#   capabilities { "tools": bool, "vision": bool, "reasoning": bool }；未声明的维度按内置
#                元数据与名称启发式推断
#   maxTokens / contextWindow / supportsImages / experimental 亦可声明
# 例：[{ "id": "my-model", "name": "My Model", "provider": "anthropic",
#        "protocol": "anthropic-messages", "capabilities": { "tools": true, "reasoning": true },
#        "apiBase": "https://api.anthropic.com/v1/messages", "apiKey": "sk-..." }]
AURAXIS_MODELS=

# 研究驱动模块开关（可选）
# AURAXIS_ALLOW_UNSAFE_CODE=1                # 仅受信开发环境：允许 RunCode/动态插件/内联工作流执行任意代码
# AURAXIS_MEMORY_RISK_GATE=1       # MAP-Graph 记忆风险门控（M5，默认关闭）
# AURAXIS_MEMORY_EMBEDDINGS=1      # R4 本地确定性向量路由（默认关闭）
# AURAXIS_MEMORY_LLM_SIGNALS=1     # 追加 LLM 信号检测（默认规则检测）

# LLM 网关
# AURAXIS_LLM_RPM=60               # 每分钟 LLM 请求上限（默认不限流）。限流只会"等"，
#                                  # 不会让请求失败；不预借突发额度（严格匀速）。
# AURAXIS_MODEL_PRICING='{"deepseek-v4-pro":{"inputPerMillion":0.28,"outputPerMillion":0.42}}'
#                                  # 每百万 token 单价（USD，输入/输出各一），用于成本统计。
#                                  # 只做精确匹配，不做前缀：没收录的模型显示为"未计价"而不是猜一个价格。
#                                  # 设为 0 成本的口径请显式写 0，不要用缺省值代替。

# 提示词变体（评测实验开关，默认关闭）
# AURAXIS_PROMPT_VARIANT_FILE=evals/prompts/mine.txt
#   把该文件的文本**追加**到系统提示词末尾（无头路径直接追加；Chat 路径插在缓存前缀
#   之后的第 4 条消息，绝不进静态前缀）。生效时会打日志 —— 一个能悄悄改产品提示词的
#   环境变量必须留痕。配 scripts/prompt-ab.cjs 做 A/B。

# 语义缓存（默认关闭）
# AURAXIS_SEMANTIC_CACHE=1         # 只缓存辅助性 LLM 产物（当前仅会话标题）；绝不缓存主对话回复
# AURAXIS_SEMANTIC_CACHE_THRESHOLD=0.95   # 相似度阈值；默认实现是词面哈希，调低会放大无关键

# 本地账户（默认开启登录门；仅测试/CI 环境设 AURAXIS_AUTH_DISABLED=1）
# AURAXIS_AUTH_DISABLED=1
# AURAXIS_USER_DATA_DIR=

# 遥测（opt-in：AURAXIS_TELEMETRY_MODE=1 开启，默认关闭）
AURAXIS_TELEMETRY_MODE=

# Agent 轨迹 OTLP 导出（默认关闭：不设置 endpoint 即完全不导出）
# 导出 run / turn / tool / subagent 四类 span（approval 作为根 span 属性）；
# 不生成 llm span —— 轨迹契约里没有逐次模型调用的耗时/token 采集源。
# 投递失败只记日志，绝不影响 Agent 运行。
# AURAXIS_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# AURAXIS_OTLP_SERVICE_NAME=auraxis
# AURAXIS_OTLP_HEADERS=authorization=Bearer xxx,x-tenant=acme

# SDK/ACP 安全（可选但强烈建议）
# AURAXIS_SDK_TOKEN=<随机字符串>          # 设置后 SDK agent.run/session.search 必须携带匹配 token
# 未设置时 SDK TCP 服务会自动生成随机 token 并通过 stdout 告知客户端
# AURAXIS_SDK_AUTOAPPROVE=0               # 仅当 =1 时才允许 SDK 全自动无头执行（默认保留审批门）
# AURAXIS_ACP_AUTOAPPROVE=0               # 仅当 =1 时才允许 ACP 全自动执行（默认保留审批门）

# 无人值守任务安全（默认关闭全自动）
# AURAXIS_UNATTENDED_AUTOAPPROVE=1        # 允许 cron/跟进/工作流以全自动全权限执行（默认走 ask 审批）
# AURAXIS_TRUST_PROJECT_HOOKS=1           # 信任并加载项目目录 .auraxis/hooks.json（默认不加载）
# AURAXIS_TRUST_PROJECT_RULES=1           # 信任并加载项目目录 .auraxis/rules/*.rules（默认不加载）

# 日志保留（默认 180 天 / 单文件 256MB）
# AURAXIS_LOG_RETENTION_DAYS=
# AURAXIS_LOG_MAX_FILE_MB=

# 远程 MCP（Streamable HTTP）出口策略
# AURAXIS_MCP_ALLOWED_HOSTS=mcp.example.com,.internal.example.com  # 主机白名单；不设则不限制主机
# AURAXIS_MCP_ALLOW_PRIVATE_HOSTS=1       # 允许连接内网地址的 MCP（默认拒绝，防 SSRF）
