{
  "name": "auraxis",
  "version": "3.1.0",
  "description": "Auraxis - 桌面端 AI 智能体工作台：编码 / 文档 / 自动化，支持多智能体调度与插件扩展",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run electron:compile && tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "tsc -p tsconfig.electron.json && concurrently \"vite\" \"wait-on http://localhost:5173 && node scripts/electron-dev.js\"",
    "electron:build": "tsc -p tsconfig.electron.json && vite build && electron-builder",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "cli": "tsc -p tsconfig.electron.json && electron dist-electron/main.js",
    "cli:run": "npm run cli -- --run",
    "sdk:build": "tsc -p packages/auraxis-sdk/tsconfig.json",
    "sdk:test": "vitest run packages/auraxis-sdk",
    "sdk:test:py": "python -m unittest discover -s python/auraxis_sdk/tests -t python/auraxis_sdk",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "tsc -p tsconfig.electron.json && vite build && node scripts/smoke-electron.cjs",
    "test:e2e": "npm run electron:compile && vite build && playwright test",
    "test:backend": "vitest run electron/ipc",
    "test:frontend": "vitest run src",
    "test:all": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run electron:compile && npx tsc --noEmit -p tsconfig.json && npm run test && npm run check:docs",
    "check:docs": "node scripts/check-doc-parity.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.1",
    "adm-zip": "^0.6.0",
    "allotment": "^1.20.5",
    "antd": "^5.20.0",
    "axios": "^1.7.0",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "docx": "^9.7.1",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.10.0",
    "iconv-lite": "^0.7.2",
    "katex": "^0.16.45",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "mermaid": "^11.15.0",
    "mime-types": "^2.1.35",
    "node-pty": "^1.1.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "react-virtuoso": "^4.18.7",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "ssh2": "^1.17.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^14.3.0",
    "@types/adm-zip": "^0.5.8",
    "@types/mime-types": "^2.1.0",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^8.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "wait-on": "^7.2.0",
    "@types/dagre": "^0.7.54"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "image-size": "file:vendor/image-size-safe"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  }
}
